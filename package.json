{
  "name": "okf-wiki",
  "version": "0.5.1",
  "description": "Ultra-lightweight OKF v0.2 knowledge base following the LLM Wiki pattern. Bun + Vite + TypeScript, served to your own browser.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:unix": "bash scripts/setup.sh",
    "icon": "bun run scripts/make-icon.ts",
    "init-bundle": "bun run scripts/init-bundle.ts",
    "build:view": "vite build",
    "dev": "vite",
    "ui": "bun run src/bun/cli/main.ts ui",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.view.json",
    "check": "bun run typecheck && bun test",
    "mcp": "bun run src/bun/mcp/standalone.ts",
    "size": "bun run scripts/size-report.ts",
    "build:headless": "bun run scripts/build-headless.ts",
    "headless": "bun run src/bun/mcp/standalone.ts",
    "bench:workload": "bun run scripts/bench/workload.ts",
    "okf": "bun run src/bun/cli/main.ts",
    "release": "bun run scripts/release.ts",
    "build:cli": "bun build --compile --minify --outfile build/cli/okf src/bun/cli/main.ts"
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "marked": "^15.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "bin": {
    "okf": "./src/bun/cli/main.ts"
  }
}
