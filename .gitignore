node_modules/

# Vite output for the webview, copied into the app at build time
src/mainview/dist/

# Compiled headless server
build/
artifacts/

# `bun build --compile` writes the executable here first, then moves it into
# place. A move that fails — the target is running, which is the normal state
# while an agent is connected — leaves a 94 MB orphan behind.
*.bun-build

# Layer 3 is derived and rebuilds from Layer 2
.rag/

# Generated by scripts/make-icon.ts during build
assets/

# Written by the setup scripts for the local machine
mcp-config.json
.launch-ui.sh

*.log
.DS_Store

# Rust port (cargo build output)
rust/target/
